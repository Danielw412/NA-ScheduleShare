SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-local-or-hosted-service-role-key
SCHEDULE_ENGINE_WORKER_ID=my-laptop

# Start the GUI with automatic queue processing enabled. The GUI switch can
# turn this on or off for the current worker session.
SCHEDULE_ENGINE_AUTO_PROCESS=false

# The staged search normally stops after moving five unrelated courses. A
# laptop operator can raise this (up to 20) for an intentionally deeper run.
SCHEDULE_ENGINE_MAX_COLLATERAL_CHANGES=5

# Use the same SMTP provider configured for Supabase Auth. These values stay on
# the laptop and are never VITE_* frontend variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ScheduleShare <no-reply@naclubs.net>
SCHEDULE_ENGINE_APP_URL=https://schedule.naclubs.net/#/schedule-engine
SCHEDULE_ENGINE_GUI_PORT=4174
