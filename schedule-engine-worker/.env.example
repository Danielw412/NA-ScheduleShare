SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-local-or-hosted-service-role-key
SCHEDULE_ENGINE_WORKER_ID=my-laptop

# Local Supabase development only. The worker rejects placeholder results for
# hosted Supabase URLs and when NODE_ENV=production.
SCHEDULE_ENGINE_ENABLE_PLACEHOLDER=false
NODE_ENV=development

# Use the same SMTP provider configured for Supabase Auth. These values stay on
# the laptop and are never VITE_* frontend variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ScheduleShare <no-reply@naclubs.net>
SCHEDULE_ENGINE_APP_URL=https://schedule.naclubs.net/#/schedule-engine
SCHEDULE_ENGINE_GUI_PORT=4174
