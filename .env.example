VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ENABLE_DEMO_MODE=false
VITE_SCHEDULE_SHARE_BASE_URL=https://schedule-api.naclubs.net

# Observability (docs/observability.md)
# Release attached to error reports; CI sets this to the commit SHA.
VITE_APP_RELEASE=
# Set to "off" to stop sending error reports to the first-party issue store.
VITE_ISSUE_REPORTING=on
# Reserved for the future Sentry integration. A DSN is public by design.
VITE_SENTRY_DSN=
